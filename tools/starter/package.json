{
  "name": "@builtbysasha/starter",
  "version": "2.0.0",
  "description": "Interactive CLI to scaffold template files into the current project",
  "license": "MIT",
  "author": {
    "name": "Aleksandr Miroshnichenko",
    "url": "https://t.me/sashafromlibertalia"
  },
  "homepage": "https://github.com/sashafromlibertalia/dev/tree/main/tools/starter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sashafromlibertalia/dev.git",
    "directory": "tools/starter"
  },
  "bugs": {
    "url": "https://github.com/sashafromlibertalia/dev/issues"
  },
  "type": "module",
  "bin": {
    "starter": "./bin/starter.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc && rm -rf dist/templates && cp -R ../../templates dist/templates",
    "typecheck": "tsc --noEmit",
    "start": "node ./bin/starter.js",
    "dev": "pnpm build && pnpm start",
    "prepack": "pnpm build",
    "release": "./release.sh",
    "release:patch": "./release.sh patch",
    "release:minor": "./release.sh minor",
    "release:major": "./release.sh major"
  },
  "dependencies": {
    "@inquirer/checkbox": "^5.2.1",
    "@inquirer/confirm": "^6.1.1",
    "@inquirer/core": "^11.2.1",
    "@inquirer/prompts": "^8.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  }
}
